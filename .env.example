# Environment Configuration Example for Bhumi Kobocho (ভূমি কবচ)
# DEMO MODE ONLY - No live government credentials or real personal data

PORT=8000
HOST=127.0.0.1

# Backend CORS & Frontend URL settings (comma-separated origins for production deployment)
# Set your live frontend domain here on Render dashboard (e.g. https://bhumi-kobocho.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=https://bhumi-kobocho-api.onrender.com

# Optional LLM Key for Explainer (Fallback uses deterministic Bangla/English templates)
OPENAI_API_KEY=
GEMINI_API_KEY=
EXPLAINER_PROVIDER=template

# OCR Settings
TESSERACT_CMD=
ENABLE_TESSERACT=false
